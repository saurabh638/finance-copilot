# Copy to .env and fill in. NEVER commit .env. Real values stay on your machine only.
# Add every new variable here in the same change that introduces it.

APP_ENV=development
# Generate a long random value, e.g.: docker compose run --rm backend python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
# How long a login session stays valid.
SESSION_TTL_DAYS=30
# Login rate limit: after this many failures within the window, logins are blocked (429).
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
# Balance check: a write-off above this many paise (100000 = Rs 1,000) is worth a
# second look first. The user is asked, never blocked.
BALANCE_CHECK_WARNING_PAISE=100000
# The daily job that works out interest, inside the backend process. Leave it on
# for normal use; the test suite turns it off so it never gains a second writer.
SCHEDULER_ENABLED=true

POSTGRES_USER=finance
POSTGRES_PASSWORD=change-me
POSTGRES_DB=finance
DATABASE_URL=postgresql+psycopg://finance:change-me@db:5432/finance
# Dedicated database for pytest integration tests, created by scripts/db/init.
TEST_DATABASE_URL=postgresql+psycopg://finance:change-me@db:5432/finance_test

# Used once by the create-user command (Milestone 3)
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-me

# AI runtime (used from Milestone 17; leave empty until then)
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
# Daily spend ceiling for the AI client, in paise (e.g. 5000 = Rs 50)
AI_DAILY_BUDGET_PAISE=5000
